{
  "expo": {
    "name": "Estudio Burnout",
    "slug": "estudio-burnout",
    "scheme": "estudioburnout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pe.edu.unitru.estudioburnout",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      }
    },
    "android": {
      "package": "pe.edu.unitru.estudioburnout",
      "adaptiveIcon": {
        "backgroundColor": "#E8F3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "La videoconsulta con tu psicólogo necesita acceso a la cámara.",
          "microphonePermission": "La videoconsulta con tu psicólogo necesita acceso al micrófono."
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para abrir el estudio con Face ID en lugar de tu contraseña."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F7",
      "imageWidth": 160
    }
  }
}
