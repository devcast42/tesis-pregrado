# Copiar a .env y completar. Ninguna de estas claves debe llegar al cliente.

LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Bucket donde LiveKit deja el audio (S3 o Cloudflare R2)
S3_ACCESS_KEY=
S3_SECRET=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_PUBLIC_BASE=

# ESP-004 RN-004-09 — plazo de borrado de audio y transcripción
RETENCION_DIAS=30
